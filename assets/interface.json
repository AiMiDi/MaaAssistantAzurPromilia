{
    "interface_version": 2,
    "name": "MaaAssistantAzurPromilia",
    "label": "蓝色星原助手",
    "title": "蓝色星原助手 · 家园优先开发版",
    "version": "v0.1.0-dev",
    "description": "基于 MaaFramework 的蓝色星原 PC 助手。家园优先：收获、制作食物、一键补餐。",
    "github": "https://github.com/AiMiDi/MaaAssistantAzurPromilia",
    "license": "LICENSE",
    "welcome": "welcome.md",
    "controller": [
        {
            "name": "Win32",
            "label": "电脑版 · 前台控制",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "^UnityWndClass$",
                "window_regex": "^AzurPromilia$",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        }
    ],
    "resource": [
        {
            "name": "bilibili",
            "label": "bilibili PC（中文）",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "../.venv/Scripts/python.exe",
        "child_args": [
            "-X",
            "utf8",
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "LaunchAndEnter",
            "label": "启动游戏 · 更新并进入",
            "entry": "LaunchAndEnter",
            "description": "通过官方启动器打开游戏，自动确认游戏资源更新，等待加载并进入主界面。登录、验证码需手动完成；等待最多 10 分钟。"
        },
        {
            "name": "HomeRoutine",
            "label": "家园日常 · 收获 → 小麦饼 → 补餐",
            "entry": "HomeRoutine",
            "description": "收获（含牧场）；先读餐桌缺口并扣除现有饼干，仅制作所缺小麦饼再补餐。小麦不足报告缺口和所需种子产量，不自动整批补种。",
            "option": [
                "Cooking"
            ]
        },
        {
            "name": "ClaimRewards",
            "label": "一键领取 · 已适配奖励",
            "entry": "ClaimRewards",
            "description": "依次检查邮件、签到、日常、周常、小小侠客养成记、星之旅录及成就积分阶段奖励；遇到未识别页面停止并报告。请勿与对应单项重复勾选。"
        },
        {
            "name": "ClaimWeekly",
            "label": "周常任务与活跃度奖励（测试）",
            "entry": "ClaimWeekly",
            "description": "检查顶部可领取任务及20～100活跃宝箱；当前已验证无奖励分支，实际达标领取待验证。"
        },
        {
            "name": "ClaimTraining",
            "label": "活动 · 小小侠客养成记",
            "entry": "ClaimTraining",
            "description": "检查已解锁天数页的首屏领取按钮，一次领取后重新确认状态。当前未涵盖35任务最终角色奖励。"
        },
        {
            "name": "ClaimTravel",
            "label": "星之旅录 · 任务与阶段奖励",
            "entry": "ClaimTravel",
            "description": "逐分类和章节检查排序后的首行任务；未完成或已领取即停止下翻。进入及任务领取后独立检查50～300积分阶段奖励，190档已实领。"
        },
        {
            "name": "ClaimAchievements",
            "label": "成就 · 积分阶段奖励（测试）",
            "entry": "ClaimAchievements",
            "description": "读取左下角当前/目标积分，仅达标时领取阶段奖励并核对下一档进度。135/200未达标跳过已实测，达标领取待验证。"
        },
        {
            "name": "ClaimMail",
            "label": "邮件 · 全部领取",
            "entry": "ClaimMail",
            "description": "领取全部邮件附件，识别奖励或已领完提示后退出。"
        },
        {
            "name": "ClaimSignIn",
            "label": "签到 · 来自星海的礼赠",
            "entry": "ClaimSignIn",
            "description": "领取当前可领取签到卡片，确认卡片状态稳定；已领取则跳过，完成后返回菜单。"
        },
        {
            "name": "ClaimDaily",
            "label": "日常任务与活跃度奖励（测试）",
            "entry": "ClaimDaily",
            "description": "按默认排序检查顶部可领取任务，领取一次后重新识别；遇到已领取或未完成即停止下翻，另行检查20～100活跃宝箱。"
        },
        {
            "name": "HomeCollect",
            "label": "家园 · 一键收获（含牧场）",
            "entry": "HomeCollect",
            "description": "领取生产、耕作、采集产物，再领取奇波牧场旁的篮子；确认收获清单和篮子消失。"
        },
        {
            "name": "HomeFeed",
            "label": "家园 · 仅添加小麦饼",
            "entry": "HomeFeed",
            "description": "只选择小份波波饼填充餐桌；餐桌已满或没有饼干则跳过。"
        },
        {
            "name": "WorkbenchTarget",
            "label": "工作台 · 商品目标制作（含原料与多设施）",
            "entry": "WorkbenchTarget",
            "description": "按目标库存补齐六种商品及软木板、木炭、尘石砖、风铜锭。利用已有材料缓冲，将可开工步骤分配到同类空闲设施；收获验证后继续下游。已有未知队列保留，缺少不可制作原料则报告。",
            "option": [
                "WorkbenchItem",
                "WorkbenchMode",
                "WorkbenchQuantity"
            ]
        },
        {
            "name": "HomeOrders",
            "label": "家园 · 订单看板",
            "entry": "HomeOrders",
            "description": "从看板附近或订单页开始；处理出货结算和财报，读取明日预告，核对 Wiki 后提交库存足够的订单。已适配的工作台配方按缺口制作再提交，其余缺料订单保留并报告。最多20分钟；不刷新订单、不操作出货箱。"
        }
    ],
    "option": {
        "Cooking": {
            "type": "select",
            "label": "烹饪策略",
            "default_case": "Maximum",
            "cases": [
                {
                    "name": "Maximum",
                    "label": "按餐桌缺口制作（扣除现有饼干）",
                    "pipeline_override": {
                        "HomeRoutine": {
                            "custom_action_param": {
                                "kind": "home",
                                "cook": true,
                                "maximum": true
                            }
                        }
                    }
                },
                {
                    "name": "One",
                    "label": "仅制作 1 份",
                    "pipeline_override": {
                        "HomeRoutine": {
                            "custom_action_param": {
                                "kind": "home",
                                "cook": true,
                                "maximum": false
                            }
                        }
                    }
                },
                {
                    "name": "Skip",
                    "label": "本轮跳过制作",
                    "pipeline_override": {
                        "HomeRoutine": {
                            "custom_action_param": {
                                "kind": "home",
                                "cook": false
                            }
                        }
                    }
                }
            ]
        },
        "WindowPin": {
            "type": "switch",
            "label": "运行时置顶游戏",
            "description": "任务开始时恢复并置顶游戏窗口；结束、失败或停止时恢复原置顶状态。",
            "default_case": "On",
            "cases": [
                {
                    "name": "On",
                    "label": "开启",
                    "pipeline_override": {
                        "WindowPolicy": {
                            "attach": {
                                "topmost": true
                            }
                        }
                    }
                },
                {
                    "name": "Off",
                    "label": "关闭",
                    "pipeline_override": {
                        "WindowPolicy": {
                            "attach": {
                                "topmost": false
                            }
                        }
                    }
                }
            ]
        },
        "GameLaunch": {
            "type": "switch",
            "label": "连接前自动启动游戏",
            "default_case": "On",
            "cases": [
                {
                    "name": "On",
                    "label": "开启"
                },
                {
                    "name": "Off",
                    "label": "关闭（手动启动）"
                }
            ]
        },
        "GameLaunchPath": {
            "type": "input",
            "label": "游戏安装路径",
            "description": "填写官方启动器 launcher.exe 路径或游戏安装根目录。助手通过官方启动器进入游戏，遇到登录或验证码时需要手动处理。",
            "inputs": [
                {
                    "name": "path",
                    "label": "路径",
                    "default": "E:\\AzurPromilia bilibili"
                }
            ]
        },
        "GameLaunchTimeout": {
            "type": "input",
            "label": "等待游戏窗口",
            "inputs": [
                {
                    "name": "seconds",
                    "label": "最长等待秒数",
                    "default": "120",
                    "verify": "^[0-9]{2,3}$",
                    "pattern_msg": "请输入 10～600 秒"
                }
            ]
        },
        "WorkbenchMode": {
            "type": "select",
            "label": "制作方式",
            "default_case": "Preview",
            "cases": [
                {
                    "name": "Preview",
                    "label": "仅预览材料与顺序",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "execute": false
                            }
                        }
                    }
                },
                {
                    "name": "Make",
                    "label": "实际制作并收获",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "execute": true
                            }
                        }
                    }
                }
            ]
        },
        "WorkbenchQuantity": {
            "type": "input",
            "label": "最终拥有的商品数量",
            "inputs": [
                {
                    "name": "count",
                    "label": "目标库存（不是追加数量）",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^(?:[1-9]|10)$",
                    "pattern_msg": "请输入 1～10"
                }
            ],
            "pipeline_override": {
                "WorkbenchPolicy": {
                    "attach": {
                        "quantity": "{count}"
                    }
                }
            }
        },
        "WorkbenchItem": {
            "type": "select",
            "label": "目标商品",
            "default_case": "all",
            "cases": [
                {
                    "name": "all",
                    "label": "全部已适配商品",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "item_id": "all"
                            }
                        }
                    }
                },
                {
                    "name": "1200001",
                    "label": "苗鸡木雕",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "item_id": "1200001"
                            }
                        }
                    }
                },
                {
                    "name": "1200002",
                    "label": "迷你狼神石俑",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "item_id": "1200002"
                            }
                        }
                    }
                },
                {
                    "name": "1200017",
                    "label": "浮音风铃",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "item_id": "1200017"
                            }
                        }
                    }
                },
                {
                    "name": "1200027",
                    "label": "密文环饰",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "item_id": "1200027"
                            }
                        }
                    }
                },
                {
                    "name": "1200029",
                    "label": "凝质晶球",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "item_id": "1200029"
                            }
                        }
                    }
                },
                {
                    "name": "1200030",
                    "label": "软绒围巾",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "item_id": "1200030"
                            }
                        }
                    }
                },
                {
                    "name": "350000",
                    "label": "软木板",
                    "pipeline_override": {
                        "WorkbenchPolicy": {
                            "attach": {
                                "item_id": "350000"
                            }
                        }
                    }
                }
            ]
        }
    },
    "global_option": [
        "WindowPin"
    ],
    "pretask": {
        "name": "LaunchGame",
        "label": "启动游戏",
        "description": "连接前启动蓝色星原；已运行时直接复用。启动失败详情见 debug/launcher.log。",
        "exec": "../.venv/Scripts/python.exe",
        "args": [
            "-X",
            "utf8",
            "./agent/launcher.py"
        ],
        "controller": [
            "Win32"
        ],
        "option": [
            "GameLaunch",
            "GameLaunchPath",
            "GameLaunchTimeout"
        ]
    }
}
